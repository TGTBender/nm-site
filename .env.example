# Copy to .env.local for local development. NEVER commit .env.local.
#
# Resend API key — https://resend.com/api-keys
# Without it the contact form still works locally and logs submissions
# to the console instead of sending mail.
#
# In production this must be set as a Vercel Environment Variable, and the
# sending domain (nm.thegreenestthumb.org) must be DNS-verified in Resend
# or every send will fail.
RESEND_API_KEY=
